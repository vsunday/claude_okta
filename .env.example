# Copy to .env and fill in the values: cp .env.example .env

# Okta authorization server, e.g. https://<your-org>.okta.com/oauth2/<auth-server-id>
OKTA_ISSUER=
# Client ID of the Okta API service app
OKTA_CLIENT_ID=
# kid of the public key registered on the Okta app (must match OKTA_PRIVATE_KEY_PATH)
OKTA_KEY_ID=
# Path to the PEM-encoded RSA private key used to sign the client assertion
OKTA_PRIVATE_KEY_PATH=

ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
# Optional
ANTHROPIC_WORKSPACE_ID=

# Required only when running with --messages
ANTHROPIC_MODEL=
# Optional prompt for --messages
ANTHROPIC_PROMPT=
